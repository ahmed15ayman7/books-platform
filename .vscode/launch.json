    "version": "0.2.0",
    "configurations": [
        {
            "name": "booksplatform (dev)",
            "request": "launch",
            "type": "dart",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "args": ["--dart-define=ENVIRONMENT=dev"]
        },
        {
            "name": "booksplatform (prod)",
            "request": "launch",
            "type": "dart",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "args": ["--dart-define=ENVIRONMENT=prod"]
        },
        {
            "name": "booksplatform (dev, profile)",
            "request": "launch",
            "type": "dart",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": ["--dart-define=ENVIRONMENT=dev"]
        },
        {
            "name": "booksplatform (prod, release)",
            "request": "launch",
            "type": "dart",
            "cwd": "mobile",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": ["--dart-define=ENVIRONMENT=prod"]
        },
        {
            "name": "mobile",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "mobile (profile mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "mobile (release mode)",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
